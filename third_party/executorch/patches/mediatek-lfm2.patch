+class Lfm2ShortConvLayer(nn.Module):
+    def __init__(self, config: Lfm2Config, jit_trace=False):
+        super().__init__()
+        self.config = config
+        self.jit_trace = jit_trace
+        self.dim = config.hidden_size
+        self.num_kv_heads = config.num_key_value_heads
+        self.head_dim = getattr(config, "head_dim", config.hidden_size // config.num_attention_heads)
+        self.L_cache = config.conv_L_cache
+
+        self.input_norm = RMSNorm(config.hidden_size, eps=config.norm_eps).float()
+        self.B_proj = nn.Linear(self.dim, self.dim, bias=False)
+        self.C_proj = nn.Linear(self.dim, self.dim, bias=False)
+        self.x_proj = nn.Linear(self.dim, self.dim, bias=False)
+        self.conv = nn.Conv1d(
+            self.dim,
+            self.dim,
+            kernel_size=self.L_cache,
+            padding=0,
+            groups=self.dim,
+            bias=False,
+        )
+        self.out_proj = nn.Linear(self.dim, self.dim, bias=False)
+        self.post_attention_norm = RMSNorm(config.hidden_size, eps=config.norm_eps).float()
+        self.mlp = MLP(config)
+
+    def forward(self, hidden_states, mask, pos_emb, past_key, past_value):
+        residual = hidden_states
+        if self.jit_trace:
+            normed = self.input_norm(hidden_states)
+        else:
+            dtype = hidden_states.dtype
+            normed = self.input_norm(hidden_states.to(torch.float32)).to(dtype)
+
+        q_len = normed.shape[1]
+        B = self.B_proj(normed).transpose(-1, -2)
+        C = self.C_proj(normed).transpose(-1, -2)
+        X = self.x_proj(normed).transpose(-1, -2)
+        Bx = B * X
+
+        # conv_state is carried in past_key's first 8 rows
+        # shape: (1, num_kv_heads, 8, head_dim) -> (1, 8*8*64) -> (1, dim, L_cache - 1)
+        state = past_key[:, :, :8, :].reshape(1, self.dim, self.L_cache - 1)
+        Bx_padded = torch.cat([state, Bx], dim=-1)
+        new_state = Bx_padded[:, :, -(self.L_cache - 1):]
+        conv_out = self.conv(Bx_padded)[:, :, :q_len]
+        y = (C * conv_out).transpose(-1, -2).contiguous()
+        conv_out = self.out_proj(y)
+        hidden_states = residual + conv_out
+
+        residual = hidden_states
+        if self.jit_trace:
+            normed = self.post_attention_norm(hidden_states)
+        else:
+            dtype = hidden_states.dtype
+            normed = self.post_attention_norm(hidden_states.to(torch.float32)).to(dtype)
+        mlp_out = self.mlp(normed)
+        hidden_states = residual + mlp_out
+
+        next_key = torch.cat(
+            [new_state.reshape(1, self.num_kv_heads, 8, self.head_dim), past_key[:, :, 8:, :]],
+            dim=2,
+        )
+        next_value = past_value
+        return hidden_states, next_key, next_value
+
