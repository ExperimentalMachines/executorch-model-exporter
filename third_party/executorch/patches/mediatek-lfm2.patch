+    def forward(self, inputs_embeds, mask, pos_emb, *cache):
+        if not self.jit_trace:
+            assert (
+                len(cache) == 2 * self.num_blocks
+            ), f"split cache wrong number of input caches: {len(cache)} != 2*{self.num_blocks}"
+            assert (
+                cache[0].shape[0] == inputs_embeds.size()[0]
+            ), f"split cache batch size mismatch: {cache[0].shape[0]} != {inputs_embeds.size()[0]}"
+
+        hidden_states = inputs_embeds
+        next_key_cache = []
+        next_value_cache = []
+
+        for idx, layer in enumerate(self.layers):
+            layer_device = self.device_list[idx] if self.device_list else hidden_states.device
+            hidden_states, next_k, next_v = layer(
+                hidden_states.to(layer_device),
+                mask=mask.to(layer_device),
+                pos_emb=pos_emb.to(layer_device),
+                past_key=cache[idx].to(layer_device),
+                past_value=cache[self.num_blocks + idx].to(layer_device),
+            )
+            next_key_cache.append(next_k.to(inputs_embeds.device))
+            next_value_cache.append(next_v.to(inputs_embeds.device))
+
+        if self.include_tail:
+            tail_device = self.device_list[-1] if self.device_list else hidden_states.device
+            if self.jit_trace:
+                hidden_states = self.norm(hidden_states.to(tail_device))
