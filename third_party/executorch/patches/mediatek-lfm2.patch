+class Lfm2ModelChunk(BaseModelChunk):
+    def __init__(
+        self,
+        config: Lfm2Config,
+        num_blocks,
+        chunk_idx,
+        dtype=torch.float32,
+        include_tail=False,
+        return_attn=False,
+        jit_trace=False,
+    ):
+        super().__init__(
+            config, num_blocks, chunk_idx, dtype, include_tail, return_attn, jit_trace
+        )
+        self.head_dim = getattr(
+            self.config, "head_dim", config.hidden_size // config.num_attention_heads
+        )
+
+        start_layer_idx = chunk_idx * num_blocks
+        self.layers = nn.ModuleList()
+        for i in range(num_blocks):
+            global_idx = start_layer_idx + i
+            layer_type = self.config.layer_types[global_idx]
+            if layer_type == "conv":
+                self.layers.append(Lfm2ShortConvLayer(config, jit_trace=jit_trace))
+            else:
+                self.layers.append(Lfm2AttentionLayer(config, jit_trace=jit_trace))
+
+        if self.include_tail:
+            self.norm = RMSNorm(config.hidden_size, eps=config.norm_eps).float()
+            self.lm_head = nn.Linear(config.hidden_size, config.vocab_size)
